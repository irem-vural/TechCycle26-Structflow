{
  "name": "istinat-duvari",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist-electron/desktop/electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "start": "next start",
    "lint": "eslint",
    "preelectron:dev": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development next dev --webpack\" \"tsc -p tsconfig.electron.json -w\" \"wait-on tcp:3000 file:dist-electron/desktop/electron/main.js file:dist-electron/desktop/electron/preload.js && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run typecheck && cross-env ELECTRON_STATIC_EXPORT=true next build && npm run electron:compile && electron-builder",
    "video:studio": "remotion studio tooling/remotion/index.ts",
    "video:capture-ui": "npm run build && node tooling/remotion/capture-ui.cjs",
    "video:render": "node -e \"require('fs').mkdirSync('artifacts/generated/video',{recursive:true})\" && remotion render tooling/remotion/index.ts RetainingWallPromo artifacts/generated/video/structflow-teknofest-16x9.mp4 --codec=h264 --crf=18",
    "video:still": "node -e \"require('fs').mkdirSync('artifacts/generated/video',{recursive:true})\" && remotion still tooling/remotion/index.ts RetainingWallPromo artifacts/generated/video/structflow-teknofest-poster.png --frame=450",
    "licenses:inventory": "node tooling/scripts/generate-license-inventory.mjs",
    "docs:file-map": "node tooling/scripts/generate-file-map.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fluentui/react-icons": "^2.0.333",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.11.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.509",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.11.1",
    "prettier": "^3.8.3",
    "remotion": "^4.0.509",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.istinatduvari.app",
    "productName": "İstinat Duvarı Analiz & Tasarım",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "fileAssociations": [
      {
        "ext": "sfl",
        "name": "StructFlow Projesi",
        "description": "StructFlow Proje Dosyası",
        "mimeType": "application/x-sfl",
        "role": "Editor"
      },
      {
        "ext": "sflow",
        "name": "StructFlow Eski Projesi",
        "description": "StructFlow Eski Proje Dosyası",
        "mimeType": "application/x-sflow",
        "role": "Editor"
      },
      {
        "ext": "srw",
        "name": "İstinat Duvarı Eski Projesi",
        "description": "İstinat Duvarı Eski Proje Dosyası",
        "mimeType": "application/x-retaining-wall-project",
        "role": "Editor"
      }
    ],
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "win": {
      "icon": "public/favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
